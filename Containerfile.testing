FROM golang:alpine as builder
COPY /drivers/ .
RUN <<EORUN
cd temp-sim
go test .
go build -o /dest/tempsim .
EORUN

FROM ubuntu:latest as runner
COPY --from=builder /dest/tempsim /usr/local/bin/temp-sim
COPY /systemd/unitFiles /etc/systemd/system/
COPY /systemd/sysusers /etc/sysusers.d/

ENTRYPOINT ["/lib/systemd/systemd"]